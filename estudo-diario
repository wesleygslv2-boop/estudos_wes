            </section>
            
            <section id="implementation" class="text-center">
                 <h2 class="text-2xl font-bold focused-calm-primary mb-4">Próximos Passos: Daqui para a Ação</h2>
                 <p class="focused-calm-secondary max-w-2xl mx-auto mb-6">Transforme este plano em realidade. Siga estes passos para integrar o cronograma à sua rotina.</p>
                 <div class="flex flex-col md:flex-row items-center justify-center gap-4 text-left">
                    <div class="w-full md:w-auto flex items-center p-4 focused-calm-accent rounded-lg">
                        <span class="text-2xl mr-4">1️⃣</span>
                        <p class="focused-calm-accent-text font-semibold">Agende no <span class="font-bold">Google Agenda</span>: Crie eventos recorrentes para cada bloco de estudo. Ative as notificações!</p>
                    </div>
                    <div class="w-full md:w-auto flex items-center p-4 focused-calm-accent rounded-lg">
                        <span class="text-2xl mr-4">2️⃣</span>
                        <p class="focused-calm-accent-text font-semibold">Prepare o <span class="font-bold">Notion</span>: Use os planos do Gemini para criar suas páginas de estudo.</p>
                    </div>
                     <div class="w-full md:w-auto flex items-center p-4 focused-calm-accent rounded-lg">
                        <span class="text-2xl mr-4">3️⃣</span>
                        <p class="focused-calm-accent-text font-semibold">Revise e Adapte: Após a primeira semana, ajuste os horários conforme necessário. A consistência vence a perfeição.</p>
                    </div>
                 </div>
            </section>

        </main>
        
        <footer class="text-center mt-16 pt-8 border-t border-gray-200">
            <p class="text-sm focused-calm-secondary">Plano criado com base em princípios de alta performance e gestão de tempo. Lembre-se: "O coração do homem pode fazer planos, mas a resposta certa dos lábios vem do Senhor." - Provérbios 16:1.</p>
        </footer>

    </div>

    <script>
        const scheduleData = {
            seg: [ { time: '06:00 - 07:30', activity: 'Treino', type: 'train' }, { time: '07:30 - 08:00', activity: 'Devocional e Café', type: 'personal' }, { time: '08:00 - 09:00', activity: 'Deslocamento / Leitura: Filosofia', type: 'study' }, { time: '09:00 - 17:00', activity: 'Trabalho', type: 'work' }, { time: '17:00 - 18:30', activity: 'Deslocamento / Podcast: UX/UI', type: 'study' }, { time: '18:30 - 20:00', activity: 'Jantar / Descanso', type: 'personal' }, { time: '20:00 - 21:00', activity: 'Estudo Focado e Prático: UX/UI', type: 'study' }, { time: '21:00...', activity: 'Relaxar / Preparar para dormir', type: 'personal' }, ],
            ter: [ { time: '06:00 - 07:00', activity: 'Treino', type: 'train' }, { time: '07:00 - 08:00', activity: 'Devocional e Café da Manhã', type: 'personal' }, { time: '08:00 - 09:00', activity: 'Deslocamento / Leitura: Teologia', type: 'study' }, { time: '09:00 - 17:00', activity: 'Trabalho', type: 'work' }, { time: '17:00 - 18:30', activity: 'Deslocamento / Podcast: UX/UI', type: 'study' }, { time: '18:30 - 19:30', activity: 'Jantar / Descanso', type: 'personal' }, { time: '19:30 - 20:30', activity: 'Estudo Focado e Prático: UX/UI', type: 'study' }, { time: '20:30...', activity: 'Tempo livre / Relaxar', type: 'personal' }, ],
            qua: [ { time: '06:00 - 07:30', activity: 'Treino', type: 'train' }, { time: '07:30 - 08:00', activity: 'Devocional e Café', type: 'personal' }, { time: '08:00 - 09:00', activity: 'Deslocamento / Leitura: Política', type: 'study' }, { time: '09:00 - 17:00', activity: 'Trabalho', type: 'work' }, { time: '17:00 - 18:30', activity: 'Deslocamento / Podcast: UX/UI', type: 'study' }, { time: '18:30 - 20:00', activity: 'Jantar / Descanso', type: 'personal' }, { time: '20:00 - 21:00', activity: 'Estudo Focado e Prático: UX/UI', type: 'study' }, { time: '21:00...', activity: 'Relaxar / Preparar para dormir', type: 'personal' }, ],
            qui: [ { time: '06:00 - 07:00', activity: 'Treino', type: 'train' }, { time: '07:00 - 08:00', activity: 'Devocional e Café da Manhã', type: 'personal' }, { time: '08:00 - 09:00', activity: 'Deslocamento / Leitura: Teologia', type: 'study' }, { time: '09:00 - 17:00', activity: 'Trabalho', type: 'work' }, { time: '17:00 - 18:30', activity: 'Deslocamento / Podcast: Product Design', type: 'study' }, { time: '18:30 - 20:00', activity: 'Jantar / Tempo em família', type: 'personal' }, { time: '20:00...', activity: 'Tempo livre / Descanso', type: 'personal' }, ],
            sex: [ { time: '06:00 - 07:30', activity: 'Treino', type: 'train' }, { time: '07:30 - 08:00', activity: 'Devocional e Café', type: 'personal' }, { time: '08:00 - 09:00', activity: 'Deslocamento / Revisão Semanal (Artigos/Podcasts)', type: 'study' }, { time: '09:00 - 17:00', activity: 'Trabalho', type: 'work' }, { time: '17:00 - 18:30', activity: 'Deslocamento / Lazer (Música/Podcast livre)', type: 'personal' }, { time: '18:30...', activity: 'Livre / Social', type: 'personal' }, ],
            sab: [ { time: 'Manhã', activity: 'Treino Longo (2.5h) ou Descanso Ativo', type: 'train' }, { time: 'Tarde', activity: 'Estudo Profundo: Cristianismo/Teologia (2h)', type: 'study' }, { time: 'Resto do dia', activity: 'Livre / Social / Família', type: 'personal' }, ],
            dom: [ { time: 'Manhã', activity: 'Igreja', type: 'personal' }, { time: 'Tarde', activity: 'Descanso / Leitura Livre / Hobby', type: 'personal' }, { time: 'Noite', activity: 'Planejamento da Semana Seguinte', type: 'personal' }, ],
        };
        const tabContentData = {
            ux_subject: { title: '🎯 UX/UI & Design de Produto', description: 'Seu foco profissional. A chave é a consistência. Gere um plano de ação semanal para manter o foco.', prompt: "Aja como um mentor sênior de design UX/UI. Crie um plano de ação conciso de 5 passos para uma semana de estudo sobre 'UX/UI & Design de Produto'. O plano deve incluir um exercício prático, um conceito para pesquisar e um artigo ou capítulo de livro para ler. O usuário trabalha em tempo integral e treina com frequência, portanto as tarefas devem ser realizáveis em cerca de 1 hora por dia. Formate a resposta usando markdown com cabeçalhos e listas." },
            theology: { title: '🕊️ Cristianismo & Teologia', description: 'O alicerce da sua vida. Peça um plano de estudo devocional e reflexivo para fortalecer sua fé e cosmovisão.', prompt: "Aja como um professor de teologia. Crie um plano de estudo conciso de 3 passos para a semana focado em reflexão sobre 'Cristianismo e Teologia'. Inclua uma passagem-chave das Escrituras para meditar, um conceito teológico para explorar (por exemplo, soteriologia, eclesiologia) e uma pergunta para reflexão pessoal em um diário. O tom deve ser encorajador e pastoral. Formate a resposta usando markdown com cabeçalhos e listas." },
            others: { title: '🌱 Filosofia & Política', description: 'Seus interesses para expandir o repertório. Gere um roteiro simples para explorar um conceito e conectá-lo com eventos atuais.', prompt: "Aja como um tutor de ciência política e filosofia. Para o tema 'Filosofia e Política', crie um plano de aprendizado simples de 3 passos para um iniciante esta semana. Inclua um conceito filosófico-chave para entender, um evento de notícias recente na política brasileira para analisar a partir dessa perspectiva filosófica e uma pergunta para consideração. Formate a resposta usando markdown com cabeçalhos e listas." }
        };
        
        const scheduleDetailsContainer = document.getElementById('schedule-details');
        const dayButtons = document.querySelectorAll('.day-button');
        const focusToggle = document.getElementById('focus-toggle');
        const tabButtons = document.querySelectorAll('#tab-buttons .tab-button');
        const tabContentContainer = document.getElementById('tab-content');
        const aiPromptInput = document.getElementById('ai-prompt-input');
        const aiPromptButton = document.getElementById('ai-prompt-button');
        const aiResponseContainer = document.getElementById('ai-response-container');
        
        const API_KEY = "";
        const API_URL = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-05-20:generateContent?key=${API_KEY}`;
        
        async function callGemini(prompt, buttonToDisable) {
            if (buttonToDisable) buttonToDisable.disabled = true;
            const payload = { contents: [{ parts: [{ text: prompt }] }] };
            try {
                const response = await fetch(API_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
                if (!response.ok) { throw new Error(`API Error: ${response.statusText}`); }
                const result = await response.json();
                const text = result.candidates?.[0]?.content?.parts?.[0]?.text;
                return text || "Não foi possível obter uma resposta. Tente novamente.";
            } catch (error) {
                console.error("Gemini API call failed:", error);
                return "Ocorreu um erro ao contatar a IA. Por favor, verifique o console para mais detalhes e tente novamente.";
            } finally {
                if (buttonToDisable) buttonToDisable.disabled = false;
            }
        }
        
        function parseMarkdown(text) {
            let html = text.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>').replace(/\*(.*?)\*/g, '<em>$1</em>');
            const lines = html.split('\n');
            let inList = false;
            html = '';
            for (let line of lines) {
                if (line.trim().startsWith('- ') || line.trim().startsWith('* ')) {
                    if (!inList) { html += '<ul>'; inList = true; }
                    html += `<li>${line.trim().substring(2)}</li>`;
                } else {
                    if (inList) { html += '</ul>'; inList = false; }
                    if (line.trim().startsWith('# ')) { html += `<h3>${line.trim().substring(2)}</h3>`; } else { html += line + '<br>'; }
                }
            }
            if (inList) html += '</ul>';
            return html.replace(/<br><ul>/g, '<ul>').replace(/<\/ul><br>/g, '</ul>');
        }
        
        function showLoading(container) {
            container.innerHTML = `<div class="flex items-center justify-center h-full text-gray-500"><svg class="animate-spin h-5 w-5 mr-3" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Gerando resposta...</span></div>`;
        }
        
        function renderSchedule(day, focusMode = false) {
            const data = scheduleData[day];
            let content = '<ul class="space-y-3">';
            const filteredData = focusMode ? data.filter(item => item.type === 'study') : data;
            if (filteredData.length === 0) {
                content += `<li class="flex items-center p-3 rounded-lg focused-calm-secondary"><span class="font-semibold w-32">--</span><span>Nenhum bloco de estudo para hoje. Aproveite para descansar!</span></li>`;
            } else {
                filteredData.forEach(item => {
                    let colorClass = 'bg-gray-100';
                    if (item.type === 'study') colorClass = 'bg-blue-100';
                    if (item.type === 'train') colorClass = 'bg-green-100';
                    if (item.type === 'work') colorClass = 'bg-yellow-100';
                    content += `<li class="flex items-center p-3 rounded-lg ${colorClass}"><span class="font-semibold w-32 text-gray-700">${item.time}</span><span class="text-gray-800">${item.activity}</span></li>`;
                });
            }
            content += '</ul>';
            scheduleDetailsContainer.innerHTML = content;
        }

        function renderTabContent(tab) {
            const data = tabContentData[tab];
            let content = `<div class="p-2"><h3 class="text-xl font-bold focused-calm-primary mb-2">${data.title}</h3><p class="focused-calm-secondary mb-6">${data.description}</p><button data-tab-id="${tab}" class="action-plan-button gemini-button font-bold py-2 px-4 rounded-lg hover:bg-opacity-90 transition duration-200 flex items-center">✨ Gerar Plano de Ação Semanal</button><div id="action-plan-${tab}" class="mt-4 p-4 border border-gray-200 rounded-lg min-h-[150px] bg-gray-50 prose-styles">Clique no botão acima para gerar um plano de estudos detalhado para esta semana.</div></div>`;
            tabContentContainer.innerHTML = content;
        }

        dayButtons.forEach(button => button.addEventListener('click', () => { dayButtons.forEach(btn => btn.classList.remove('active')); button.classList.add('active'); renderSchedule(button.dataset.day, focusToggle.checked); }));
        focusToggle.addEventListener('change', () => { const activeBtn = document.querySelector('.day-button.active'); if (activeBtn) renderSchedule(activeBtn.dataset.day, focusToggle.checked); });
        tabButtons.forEach(button => button.addEventListener('click', () => { tabButtons.forEach(btn => btn.classList.remove('active')); button.classList.add('active'); renderTabContent(button.dataset.tab); }));
        
        tabContentContainer.addEventListener('click', async (e) => {
            if (e.target.classList.contains('action-plan-button')) {
                const button = e.target;
                const tabId = button.dataset.tabId;
                const prompt = tabContentData[tabId].prompt;
                const container = document.getElementById(`action-plan-${tabId}`);
                showLoading(container);
                const response = await callGemini(prompt, button);
                container.innerHTML = parseMarkdown(response);
            }
        });
        
        aiPromptButton.addEventListener('click', async () => {
            const topic = aiPromptInput.value.trim();
            if (!topic) { aiResponseContainer.textContent = "Por favor, insira um tópico para perguntar."; return; }
            const fullPrompt = `Explique o conceito de '${topic}' de forma simples e concisa, em um parágrafo. Ideal para um iniciante no assunto.`;
            showLoading(aiResponseContainer);
            const response = await callGemini(fullPrompt, aiPromptButton);
            aiResponseContainer.innerHTML = parseMarkdown(response);
        });

        document.addEventListener('DOMContentLoaded', () => {
            dayButtons[0].click();
            tabButtons[0].click();

            const chartCtx = document.getElementById('timeAllocationChart');
            if (chartCtx) {
              new Chart(chartCtx.getContext('2d'), {
                  type: 'bar',
                  data: {
                      labels: ['Trabalho & Desloc.', 'Treino', 'Estudo Essencial', 'Estudo Interesses', 'Descanso/Pessoal'],
                      datasets: [{ label: 'Horas por Semana', data: [52.5, 9, 14, 2, 45], backgroundColor: ['rgba(212, 201, 181, 0.7)', 'rgba(163, 173, 156, 0.7)', 'rgba(122, 141, 169, 0.7)', 'rgba(181, 156, 163, 0.7)', 'rgba(189, 189, 189, 0.7)'], borderColor: ['rgba(212, 201, 181, 1)', 'rgba(163, 173, 156, 1)', 'rgba(122, 141, 169, 1)', 'rgba(181, 156, 163, 1)', 'rgba(189, 189, 189, 1)'], borderWidth: 1 }]
                  },
                  options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, scales: { x: { beginAtZero: true, stacked: true, title: { display: true, text: 'Horas' } }, y: { stacked: true } }, plugins: { legend: { display: false }, tooltip: { callbacks: { label: function(context) { return `${context.dataset.label}: ${context.raw} horas`; } } } } }
              });
            }
            
            const toggle = document.querySelector('#focus-toggle');
            toggle.addEventListener('change', () => {
                const container = toggle.parentElement;
                if (!container) return;

                const dot = container.querySelector('.dot');
                const backgroundDiv = container.querySelector('.block');
                
                if (dot && backgroundDiv) {
                    if (toggle.checked) {
                        dot.style.transform = 'translateX(100%)';
                        backgroundDiv.classList.add('bg-green-400');
                        backgroundDiv.classList.remove('bg-gray-200');
                    } else {
                        dot.style.transform = 'translateX(0)';
                        backgroundDiv.classList.remove('bg-green-400');
                        backgroundDiv.classList.add('bg-gray-200');
                    }
                }
            });
        });

    </script>
</body>
</html>
